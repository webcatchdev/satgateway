# Caddy reverse proxy for SatGateway
# Install Caddy: https://caddyserver.com/docs/install
# Then run: caddy run --config Caddyfile

your-domain.com {
    # SatGateway landing page
    handle /payments {
        redir /payments/ permanent
    }
    handle /payments/ {
        root * /opt/satgateway/static/landing
        file_server
        try_files {path} /index.html
    }

    # SatGateway API — preserve /payments prefix for FastAPI router
    handle /payments/* {
        reverse_proxy localhost:9026
    }

    # Proxy everything else to your main app
    reverse_proxy localhost:8080
}
