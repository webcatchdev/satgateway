# SatGateway Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# API key for hosted/gateway mode (generate a strong random string)
SATGATEWAY_KEY=your-strong-random-key-here

# Fee in basis points (50 = 0.5%). Set to 0 for no fee.
SATGATEWAY_FEE_BPS=50

# ── Lightning Backend (LND) ───────────────────────────────────────
# Use either LND_HOST + LND_MACAROON (hex) OR LND_MACAROON_PATH
# Leave all blank to use MockBackend for development.

# LND REST endpoint (e.g., https://lnd:8080 for docker-internal)
LND_HOST=

# Macaroon as hex string (alternative to file path)
LND_MACAROON=

# Path to admin.macaroon file on disk
LND_MACAROON_PATH=

# Path to TLS certificate (if using self-signed cert)
LND_TLS_CERT_PATH=

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Optional Webhook ──────────────────────────────────────────────
# POSTed when a payment is confirmed
WEBHOOK_URL=
